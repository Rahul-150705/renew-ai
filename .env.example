# ============================================
# Renew AI - Environment Variables TEMPLATE
# ============================================
# Copy this file to .env and fill in your real values
# ============================================

# ----- Database (Neon PostgreSQL) -----
DB_URL=jdbc:postgresql://your-host.neon.tech/neondb?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ----- JWT Authentication -----
JWT_SECRET=generate_a_64_char_random_string_here

# ----- Twilio (SMS & WhatsApp) -----
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+14155238886

# ----- CORS (comma-separated allowed origins) -----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Google OAuth2 -----
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
FRONTEND_URL=https://client-connect-hub-zeta.vercel.app
ALLOWED_ORIGINS=https://client-connect-hub-zeta.vercel.app

# ----- Groq (AI extraction + NL query) -----
GROQ_API_KEY=your_groq_api_key_here
# Override the model if the default is not available on your Groq plan.
# Larger alternative: openai/gpt-oss-120b. Llama models require an Enterprise plan.
GROQ_MODEL=openai/gpt-oss-20b

# ----- AWS S3 (policy PDF storage; leave blank to disable) -----
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_secret_access_key
